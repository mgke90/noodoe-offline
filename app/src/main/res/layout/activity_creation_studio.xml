<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studioRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/studioToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/noodoe_red"
        app:title="Dashboard Studio"
        app:titleTextColor="#FFFFFF" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/studioTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/noodoe_red"
        app:tabGravity="fill"
        app:tabIndicatorColor="#FFFFFF"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabTextColor="#CCFFFFFF">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOCK" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPEEDOMETER" />
    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Clock editor -->
            <LinearLayout
                android:id="@+id/clockSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clock builder"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Use the official clock template and assets. The stock test uploads the template unchanged; custom install unlocks only after that succeeds."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.noodoe.offline.creation.DashboardPreviewView
                    android:id="@+id/clockPreview"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="12dp"
                    android:background="#111111" />

                <TextView
                    android:id="@+id/clockBackgroundLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Background: official clock 01"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <Spinner

                    style="@style/Widget.Noodoe.Spinner"
                    android:id="@+id/clockBackgroundSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickClockBackgroundButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="CUSTOM IMAGE"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/useClockTemplateButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OFFICIAL TEMPLATE"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Hand style"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner

                    style="@style/Widget.Noodoe.Spinner"
                    android:id="@+id/handStyleSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Hand colors"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hourColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="HOUR HAND  #6B6B6B"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/minuteColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MINUTE HAND  #A9A9A9"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SECOND HAND  #F12B89"
                    app:cornerRadius="12dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/secondHandSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Show second hand" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dateSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Show date / weekday" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Install over Bluetooth with the scooter key on. The stock test is the safe first step."
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/minimalStockButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="INSTALL MINIMAL STOCK CLOCK (NO DATE)"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stockInstallButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="INSTALL STOCK CLOCK WITH WEEKDAY (9 FILES)"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clockInstallButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="INSTALL CUSTOM CLOCK (stock test first)"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Speedometer editor -->
            <LinearLayout
                android:id="@+id/speedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Speedometer builder"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Analog and digital speedometers built from the official Pack B faces, needles, bars and backgrounds. Analog is confirmed on the scooter; digital uses the same transfer with the 12-file bundle and a keepalive."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.noodoe.offline.creation.DashboardPreviewView
                    android:id="@+id/speedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="12dp"
                    android:background="#111111" />

                <TextView
                    android:id="@+id/speedValueLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Preview speed: 100 km/h"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <SeekBar
                    android:id="@+id/speedSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Background"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner

                    style="@style/Widget.Noodoe.Spinner"
                    android:id="@+id/speedBackgroundSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickSpeedBackgroundButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="CUSTOM IMAGE"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/useSpeedBackgroundButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OFFICIAL BACKGROUND"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Speedometer mode"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner

                    style="@style/Widget.Noodoe.Spinner"
                    android:id="@+id/speedModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/speedModeNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Digital mode uses 12 files (background, ten digit glyphs and the cfg). Images are sent first and the cfg last, matching the official app, so the dashboard never parses an incomplete digit set. The normal install button pipelines the starts, data and finishes so the whole bundle reaches the dashboard inside its ten-second transfer window."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Unit and maximum speed"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner

                        style="@style/Widget.Noodoe.Spinner"
                        android:id="@+id/unitSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <Spinner

                        style="@style/Widget.Noodoe.Spinner"
                        android:id="@+id/maxSpeedSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Analog needle"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner

                    style="@style/Widget.Noodoe.Spinner"
                    android:id="@+id/needleStyleSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/needleColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="NEEDLE  #F12B89"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/centerColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="NEEDLE CENTER  #FFFFFF"
                    app:cornerRadius="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Speed mark"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Spinner

                    style="@style/Widget.Noodoe.Spinner"
                    android:id="@+id/markStyleSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/markColorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MARK  #FFFFFF"
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/markHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Official faces already include their marks. Choose Plain background to edit mark style and color."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/digitalOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Digital speed"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/digitalColorButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="DIGITS  #FFFFFF"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Digit tuning"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The dashboard scales each glyph into its fixed widget. Use the preview and install the speedometer to tune size, shape and position without rebuilding the app."
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <Spinner

                        style="@style/Widget.Noodoe.Spinner"
                        android:id="@+id/digitModeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <Spinner

                        style="@style/Widget.Noodoe.Spinner"
                        android:id="@+id/digitFontSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <Spinner

                        style="@style/Widget.Noodoe.Spinner"
                        android:id="@+id/digitResolutionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/digitScaleLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Digit size: 80%"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <SeekBar
                        android:id="@+id/digitScaleSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="60"
                        android:progress="40" />

                    <TextView
                        android:id="@+id/digitThicknessLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thickness: -1"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <SeekBar
                        android:id="@+id/digitThicknessSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="8"
                        android:progress="1" />

                    <TextView
                        android:id="@+id/digitOffsetXLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="X offset: 0%"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <SeekBar
                        android:id="@+id/digitOffsetXSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="60"
                        android:progress="30" />

                    <TextView
                        android:id="@+id/digitOffsetYLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Y offset: 0%"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <SeekBar
                        android:id="@+id/digitOffsetYSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="60"
                        android:progress="30" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/digitHardSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Hard 1-bit edges (off = smooth)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/digitResetButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="RESET DIGIT TUNING"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/digitTuningNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Speed bar"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <Spinner

                        style="@style/Widget.Noodoe.Spinner"
                        android:id="@+id/barStyleSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/barColorButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="BAR  #F12B89"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/showBarSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Show digital speed bar" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Speedometer installation is experimental. Validate the stock clock transfer first, then test this on the dashboard with the key on."
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedInstallButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="INSTALL SPEEDOMETER (ANALOG)"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/digitalBatchButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="INSTALL DIGITAL (BATCHED EXPERIMENT)"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/studioStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Not started"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
