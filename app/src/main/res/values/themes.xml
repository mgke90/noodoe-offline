<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NoodoeOffline" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/noodoe_red</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/noodoe_red</item>
    </style>

    <style name="Widget.Noodoe.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:popupBackground">@drawable/spinner_popup_background</item>
        <item name="android:dropDownWidth">match_parent</item>
    </style>
</resources>
